# Banco Central (Heart) — PostgreSQL
DATABASE_URL_HEART="postgresql://postgres:SENHA@localhost:5432/railway"
# Usado pelo Prisma CLI durante geração/migração de schema por loja
DATABASE_URL_TENANT="postgresql://postgres:SENHA@localhost:5432/loja_exemplo"
TENANT_DB_CONNECTION_LIMIT=5

# Segredos de Autenticação e Painel Sys-Init (OBRIGATÓRIOS em produção)
JWT_SECRET="defina-um-segredo-forte-aleatorio-em-producao"
SETUP_PIN="defina-um-pin-seguro-sys-init"
SQL_PIN="defina-um-pin-seguro-sql-editor"

# Porta e Modo de Operação
PORT=3530
APP_MODE=retail
FRONTEND_DIST_PATH="../frontend/dist"

# Armazenamento Persistente (Volume Railway)
BACKUP_STORAGE_PATH="/app/backups"
FISCAL_STORAGE_PATH="/app/storage/fiscal"

# Microsserviço Fiscal NFC-e (opcional — necessário apenas quando emissão SEFAZ estiver ativa)
NFCE_SERVICE_URL="http://nfce-service:80"
